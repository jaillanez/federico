# Production entry point. Variables come from .env.prod (see infra/.env.prod.example).
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
		# Pages also carry a stricter <meta> CSP with per-script hashes (Astro security.csp);
		# browsers enforce both, so inline scripts only run if their hash matches.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com {$ANALYTICS_ORIGIN}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$MEDIA_ORIGIN}; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com {$ANALYTICS_ORIGIN}; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
		-Server
	}

	# Old URLs of the previous site (301). TODO(federico): add them to redirects.caddy.
	import /etc/caddy/redirects.caddy

	# URLs without trailing slash (except the home page).
	@trailing path_regexp trailing ^(.+)/$
	redir @trailing {re.trailing.1} permanent

	handle /api/admin/* {
		request_body {
			max_size 300MB
		}
		reverse_proxy api:8000 {
			# Overwrite (never append) client-supplied forwarding headers.
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /api/* {
		request_body {
			max_size 45MB
		}
		reverse_proxy api:8000 {
			# Overwrite (never append) client-supplied forwarding headers.
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle {
		root * /srv/site/current
		@hashed path /_astro/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@panel path /admin /admin.html
		header @panel Cache-Control "no-store"
		@pages not path /_astro/*
		header @pages ?Cache-Control "public, max-age=0, must-revalidate"
		try_files {path} {path}.html {path}/index.html
		file_server
	}

	handle_errors 404 {
		root * /srv/site/current
		rewrite * /404.html
		file_server
	}
}
