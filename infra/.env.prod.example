# Producción. Copiá a /opt/sei/.env.prod en el servidor (permisos 600). Nunca al repositorio.
# Generá secretos con: openssl rand -hex 32

# --- Dominio y HTTPS ---
DOMAIN=servielect.com.ar
# Email para Let's Encrypt (avisos de certificados).
ACME_EMAIL=servielect@infovia.com.ar

# --- PostgreSQL ---
POSTGRES_DB=sei
POSTGRES_USER=sei_owner
POSTGRES_PASSWORD=
DB_API_USER=sei_api
DB_API_PASSWORD=

# --- API ---
SECRET_KEY=

# --- Cloudflare R2 ---
# Endpoint S3 de la cuenta: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLIC=sei-public
S3_BUCKET_PRIVATE=sei-private
BACKUP_BUCKET=sei-backups
# Dominio público del bucket de fotos (CDN de R2), p. ej. https://media.servielect.com.ar
PUBLIC_MEDIA_URL=https://media.servielect.com.ar
# Origen de ese dominio para la CSP (sin barra final).
MEDIA_ORIGIN=https://media.servielect.com.ar

# --- Correo (SMTP del proveedor de email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM="S.E.I. Servicio Eléctrico Integral <no-responder@servielect.com.ar>"
MAIL_LEADS_TO=servielect@infovia.com.ar

# --- Cloudflare Turnstile (claves reales del panel de Cloudflare) ---
TURNSTILE_SECRET_KEY=
PUBLIC_TURNSTILE_SITE_KEY=

# --- Regeneración del sitio ---
REBUILD_WEBHOOK_TOKEN=

# --- Backups ---
# Guardá esta frase también FUERA del servidor (gestor de contraseñas): sin ella no hay restauración.
BACKUP_PASSPHRASE=
BACKUP_RETENTION_DAYS=30

# --- Analítica sin cookies (opcional) ---
# Origen del script de Plausible/Umami para la CSP, p. ej. https://plausible.io
ANALYTICS_ORIGIN=

# --- Servidor compartido (ya tiene un proxy propio en 80/443) ---
# SEI_EDGE=1 usa infra/docker-compose.edge.yml: sin puertos publicados, detrás del proxy de entrada,
# con MinIO propio en lugar de R2. infra/edge-register.sh completa EDGE_PROXY_IP.
SEI_EDGE=0
EDGE_PROXY_IP=
# Con MinIO propio: URL pública del sitio, para firmar las descargas de la documentación.
S3_PRESIGN_ENDPOINT_URL=
