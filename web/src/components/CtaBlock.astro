---
import Button from './ui/Button.astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappUrl } from '@/lib/site';

interface Props {
  title?: string | undefined;
  text?: string | undefined;
}
const {
  title = '¿Querés saber cuánto podés ahorrar?',
  text = 'Enviá tu factura eléctrica o el presupuesto solar que te pasaron. Federico lo revisa personalmente y te responde en 24 a 48 horas hábiles.',
} = Astro.props;
---

<section class="bg-blueprint border-t-4 border-accent text-white" aria-labelledby="cta-title">
  <div class="container-sei grid gap-8 py-14 sm:py-20 lg:grid-cols-[1fr_auto] lg:items-center">
    <div class="max-w-2xl">
      <p class="eyebrow text-accent">Diagnóstico Exprés</p>
      <h2 id="cta-title" class="mt-3 text-h2 text-white">
        {title}
      </h2>
      <p class="mt-4 text-lead text-primary-100">{text}</p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
      <Button href="/diagnostico" variant="accent" size="lg">
        Solicitar diagnóstico
      </Button>
      <Button
        href={whatsappUrl()}
        variant="inverse"
        size="lg"
        target="_blank"
        rel="noopener"
        data-event="whatsapp_click"
      >
        <WhatsAppIcon /> Consultar por WhatsApp
      </Button>
    </div>
  </div>
</section>
