---
import Button from './ui/Button.astro';
---

<div class="mt-8 flex flex-col gap-4 rounded-card border border-accent/50 bg-accent-soft p-5 sm:flex-row sm:items-center sm:justify-between">
  <p class="text-[0.9375rem]">
    <strong>Estimación orientativa: no reemplaza el diagnóstico.</strong> Para un análisis con tus facturas reales,
    pedinos un diagnóstico.
  </p>
  <Button href="/diagnostico" variant="accent" class="shrink-0">
    Solicitar diagnóstico
  </Button>
</div>
