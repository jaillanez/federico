---
/** FAQ as native <details> (no JS). Pair with faqPage() JSON-LD on the page. */
interface Props {
  items: { pregunta: string; respuesta: string }[];
}
const { items } = Astro.props;
---

<div class="mx-auto max-w-3xl divide-y divide-line rounded-card border border-line bg-white">
  {items.map((f) => (
    <details class="group p-5 sm:p-6">
      <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-display text-lg font-bold tracking-tight [&::-webkit-details-marker]:hidden">
        <h3>{f.pregunta}</h3>
        <span
          class="mt-1 grid size-6 shrink-0 place-items-center rounded-full border border-line text-primary-700 transition-transform group-open:rotate-45"
          aria-hidden="true"
        >
          +
        </span>
      </summary>
      <p class="mt-3 text-ink-muted">{f.respuesta}</p>
    </details>
  ))}
</div>
