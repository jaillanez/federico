---
interface Props {
  items: { titulo: string; texto: string }[];
}
const { items } = Astro.props;
---

<ol class="grid gap-6 md:grid-cols-3">
  {items.map((step, i) => (
    <li class="reveal relative flex flex-col gap-3">
      <div class="flex items-center gap-3">
        <span class="grid size-10 shrink-0 place-items-center rounded-full border-2 border-primary-600 bg-white font-display font-extrabold text-primary-700">
          {i + 1}
        </span>
        {i < items.length - 1 && <span class="hidden h-px flex-1 bg-primary-200 md:block" aria-hidden="true" />}
      </div>
      <h3 class="text-h3">{step.titulo}</h3>
      <p class="text-ink-muted">{step.texto}</p>
    </li>
  ))}
</ol>
