---
/**
 * Article cover uploaded from the panel. The API stores the 1600 px WebP; an AVIF twin with the
 * same name is generated next to it. Fixed 16:9 box with object-cover, so no layout shift.
 */
interface Props {
  url: string;
  eager?: boolean;
  sizes: string;
  class?: string;
}
const { url, eager = false, sizes, class: cls } = Astro.props;
const avif = url.replace(/\.webp$/, '.avif');
---

<picture>
  <source type="image/avif" srcset={`${avif} 1600w`} sizes={sizes} />
  <img
    src={url}
    alt=""
    width="1600"
    height="900"
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : 'auto'}
    class:list={['aspect-[16/9] h-auto w-full object-cover', cls]}
  />
</picture>
