---
import WhatsAppIcon from './WhatsAppIcon.astro';
import { whatsappUrl } from '@/lib/site';
import { getSiteData } from '@/lib/api';
const { site } = await getSiteData();
---

<aside aria-label="Contacto por WhatsApp" transition:persist>
  <a
    href={whatsappUrl(site.whatsapp)}
    target="_blank"
    rel="noopener"
    data-event="whatsapp_click"
    class="fixed right-4 bottom-4 z-30 flex items-center gap-2 rounded-full bg-whatsapp p-3.5 text-white shadow-lg ring-4 ring-white/70 transition-transform hover:scale-105 sm:right-6 sm:bottom-6 lg:pr-5 print:hidden"
  >
    <WhatsAppIcon class="size-7" />
    <span class="sr-only lg:not-sr-only lg:text-[0.9375rem] lg:font-semibold">Consultar por WhatsApp</span>
  </a>
</aside>
