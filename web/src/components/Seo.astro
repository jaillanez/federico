---
/** Basic SEO tags. Open Graph images per page and JSON-LD arrive in phase 2. */
import { site } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  image?: string | undefined;
}
// TODO: phase 2 generates a 1200×630 Open Graph image per page when none is given.
const { title, description, noindex = false, image } = Astro.props;
const SUFFIX = ' | S.E.I. Ing. Federico Delgado';
const fullTitle = title.includes('S.E.I.') ? title : `${title}${SUFFIX}`;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', Astro.site);
const imageUrl = image ? new URL(image, Astro.site) : undefined;

if (import.meta.env.DEV) {
  if (fullTitle.length > 60) console.warn(`[seo] title > 60 caracteres (${fullTitle.length}): ${fullTitle}`);
  if (description.length > 155) console.warn(`[seo] description > 155 caracteres: ${Astro.url.pathname}`);
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_AR" />
<meta property="og:site_name" content={site.legalName} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
<meta name="twitter:card" content="summary_large_image" />
