---
import Icon from './Icon.astro';
interface Props {
  izquierda: { titulo: string; items: string[] };
  derecha: { titulo: string; items: string[] };
}
const { izquierda, derecha } = Astro.props;
---

<div class="grid gap-4 md:grid-cols-2 md:gap-0">
  <div class="reveal rounded-card border border-line bg-surface p-6 md:rounded-r-none sm:p-8">
    <h3 class="text-h3 text-ink-muted">{izquierda.titulo}</h3>
    <ul class="mt-5 flex flex-col gap-3">
      {izquierda.items.map((it) => (
        <li class="flex gap-3 text-ink-muted">
          <Icon name="close" class="mt-0.5 size-5 shrink-0 text-ink-muted" />
          {it}
        </li>
      ))}
    </ul>
  </div>
  <div class="reveal rounded-card border-2 border-primary-600 bg-white p-6 shadow-card md:-ml-px md:rounded-l-none sm:p-8">
    <h3 class="text-h3 text-primary-700">{derecha.titulo}</h3>
    <ul class="mt-5 flex flex-col gap-3">
      {derecha.items.map((it) => (
        <li class="flex gap-3">
          <Icon name="check" class="mt-0.5 size-5 shrink-0 text-success" />
          {it}
        </li>
      ))}
    </ul>
  </div>
</div>
