---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Section from '@/components/Section.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import Badge from '@/components/ui/Badge.astro';
import FotosObra from '@/islands/FotosObra';
import AntesDespues from '@/islands/AntesDespues';
import { getProject, getProjects, type ProjectDetail, type ProjectSummary } from '@/lib/api';
import { breadcrumbs } from '@/lib/jsonld';
import { formatMonth } from '@/lib/format';
import { required, siteUrl } from '@/lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const project: ProjectDetail = required(await getProject(Astro.params.slug ?? ''), `la obra ${Astro.params.slug}`);
const all = await getProjects();

// Related: same category first, then same sector, then same province.
const score = (p: ProjectSummary) =>
  (p.categoria?.slug === project.categoria?.slug ? 4 : 0) +
  (p.sector?.slug === project.sector?.slug ? 2 : 0) +
  (p.provincia === project.provincia ? 1 : 0);
const related = all
  .filter((p) => p.slug !== project.slug)
  .sort((a, b) => score(b) - score(a))
  .slice(0, 3);

const antes = project.imagenes.find((i) => i.tipo === 'antes');
const despues = project.imagenes.find((i) => i.tipo === 'despues');
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Obras', path: '/obras' },
  { name: project.titulo, path: `/obras/${project.slug}` },
];
const facts = [
  { dt: 'Ubicación', dd: [project.localidad, project.provincia].filter(Boolean).join(', ') },
  { dt: 'Sector', dd: project.sector?.nombre },
  { dt: 'Tipo de obra', dd: project.categoria?.nombre },
  { dt: 'Potencia', dd: project.potencia_kw ? `${project.potencia_kw.toLocaleString('es-AR')} kW` : null },
  { dt: 'Fecha', dd: project.fecha_obra ? formatMonth(project.fecha_obra) : null },
].filter((f) => f.dd);
const story = [
  { t: 'El problema', d: project.problema },
  { t: 'La solución', d: project.solucion },
  { t: 'El resultado', d: project.resultado },
].filter((s) => s.d);
const title = project.seo_title ?? project.titulo;
const description = project.seo_description ?? project.resumen ?? `${project.titulo}: obra eléctrica de S.E.I.`;
---

<BaseLayout
  title={title}
  description={description.length > 155 ? `${description.slice(0, description.lastIndexOf(' ', 152))}…` : description}
  image={`/og/obras/${project.slug}.png`}
  jsonLd={[breadcrumbs(crumbs, siteUrl(Astro.site))]}
>
  <PageHero
    eyebrow={project.categoria?.nombre ?? 'Obra eléctrica'}
    title={project.titulo}
    lead={project.resumen ?? undefined}
  >
    <Breadcrumbs items={crumbs} slot="before" />
  </PageHero>

  <Section id="obra">
    <div class="grid gap-10 lg:grid-cols-[1fr_20rem]">
      <div class="flex flex-col gap-10">
        {project.imagenes.length > 0 ? (
          <FotosObra client:visible images={project.imagenes} title={project.titulo} />
        ) : (
          <div class="aspect-[16/9] overflow-hidden rounded-card">
            <div class="bg-blueprint grid h-full place-items-center text-primary-200">
              Fotos de la obra próximamente
            </div>
          </div>
        )}
        {antes && despues && (
          <section aria-labelledby="antes-despues">
            <h2 id="antes-despues" class="mb-4 text-h3">
              Antes y después
            </h2>
            <AntesDespues client:visible antes={antes} despues={despues} />
          </section>
        )}
        <ol class="flex flex-col gap-8">
          {story.map((s, i) => (
            <li class="grid gap-3 sm:grid-cols-[3rem_1fr]">
              <span class="grid size-10 place-items-center rounded-full border-2 border-primary-600 font-display font-extrabold text-primary-700">
                {i + 1}
              </span>
              <div>
                <h2 class="text-h3">{s.t}</h2>
                <p class="mt-2 whitespace-pre-line text-ink-muted">{s.d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
      <aside class="lg:sticky lg:top-24 lg:self-start">
        <h2 class="sr-only">Datos de la obra</h2>
        <dl class="divide-y divide-line rounded-card border border-line bg-surface">
          {facts.map((f) => (
            <div class="flex justify-between gap-4 p-4 text-sm">
              <dt class="text-ink-muted">{f.dt}</dt>
              <dd class="text-right font-medium">{f.dd}</dd>
            </div>
          ))}
        </dl>
        {project.destacado && (
          <div class="mt-3">
            <Badge tone="accent">Obra destacada</Badge>
          </div>
        )}
      </aside>
    </div>
  </Section>

  {related.length > 0 && (
    <Section id="relacionadas" tone="surface" title="Obras relacionadas">
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => (
          <li>
            <ProjectCard project={p} />
          </li>
        ))}
      </ul>
    </Section>
  )}
</BaseLayout>
