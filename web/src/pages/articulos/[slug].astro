---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { getArticle, getArticles, type ArticleDetail } from '@/lib/api';
import { article as articleLd, breadcrumbs } from '@/lib/jsonld';
import { formatDate, readingMinutes } from '@/lib/format';
import { renderMarkdown } from '@/lib/markdown';
import { required, siteUrl } from '@/lib/content';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((a) => ({ params: { slug: a.slug } }));
}

const a: ArticleDetail = required(await getArticle(Astro.params.slug ?? ''), `el artículo ${Astro.params.slug}`);
const { html, toc } = renderMarkdown(a.cuerpo_md);
const minutes = readingMinutes(a.cuerpo_md);
const crumbs = [
  { name: 'Inicio', path: '/' },
  { name: 'Artículos', path: '/articulos' },
  { name: a.titulo, path: `/articulos/${a.slug}` },
];
const og = `/og/articulos/${a.slug}.png`;
const description = a.seo_description ?? a.extracto ?? a.titulo;
---

<BaseLayout
  title={a.seo_title ?? a.titulo}
  description={description.length > 155 ? `${description.slice(0, description.lastIndexOf(' ', 152))}…` : description}
  image={og}
  type="article"
  jsonLd={[articleLd(a, og, siteUrl(Astro.site)), breadcrumbs(crumbs, siteUrl(Astro.site))]}
  ctaTitle="¿Querés aplicarlo a tu empresa?"
>
  <PageHero eyebrow="Artículo" title={a.titulo} lead={a.extracto ?? undefined}>
    <Breadcrumbs items={crumbs} slot="before" />
    <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-primary-100">
      <span>
        Por{' '}
        <a href="/sobre-federico" class="font-semibold text-white underline-offset-4 hover:underline">
          Ing. Federico Delgado
        </a>
      </span>
      <span aria-hidden="true">·</span>
      <time datetime={a.publicado_at}>{formatDate(a.publicado_at)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min de lectura</span>
    </p>
  </PageHero>

  <div class="container-sei grid gap-10 py-12 sm:py-16 lg:grid-cols-[16rem_minmax(0,1fr)]">
    {toc.length > 1 ? (
      <nav aria-labelledby="indice" class="lg:sticky lg:top-24 lg:self-start">
        <h2 id="indice" class="eyebrow">
          En este artículo
        </h2>
        <ol class="mt-3 flex flex-col gap-2 border-l border-line text-sm">
          {toc.map((t) => (
            <li class:list={[t.depth === 3 ? 'pl-7' : 'pl-4']}>
              <a href={`#${t.id}`} class="text-ink-muted hover:text-primary-700">
                {t.text}
              </a>
            </li>
          ))}
        </ol>
      </nav>
    ) : (
      <div />
    )}
    <article class="prose-sei max-w-3xl">
      <Fragment set:html={html} />
      {a.tags.length > 0 && (
        <ul class="not-prose mt-10 flex flex-wrap items-center gap-2 border-t border-line pt-6" aria-label="Etiquetas">
          {a.tags.map((t) => (
            <li>
              <Badge>{t}</Badge>
            </li>
          ))}
        </ul>
      )}
      <aside class="not-prose mt-8 flex flex-col gap-4 rounded-card border border-line bg-surface p-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-medium">¿Tenés dudas sobre tu caso? Federico revisa tu factura personalmente.</p>
        <Button href="/diagnostico" variant="accent" class="shrink-0">
          Solicitar diagnóstico
        </Button>
      </aside>
    </article>
  </div>
</BaseLayout>
