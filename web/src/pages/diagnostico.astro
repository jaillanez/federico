---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import DiagnosticoForm from '@/islands/DiagnosticoForm';
import { getSiteData } from '@/lib/api';
import { INVOICE_WHATSAPP_TEXT, whatsappUrl } from '@/lib/site';
import { turnstileSiteKey } from '@/lib/turnstile-key';

const { site } = await getSiteData();
const steps = [
  { t: 'Federico revisa tu caso', d: 'Personalmente, con tu factura y el presupuesto si lo tenés.' },
  { t: 'Te contactamos en 24 a 48 h hábiles', d: 'Por email o WhatsApp, con un primer diagnóstico.' },
  { t: 'Vos decidís', d: 'Sin compromiso y sin venta de equipos.' },
];
---

<BaseLayout
  title="Diagnóstico Exprés"
  description="Auditá tu factura eléctrica o evaluá tu presupuesto solar. Recibí un primer diagnóstico técnico e imparcial en menos de 48 horas."
  image="/og/diagnostico.png"
  cta={false}
>
  <PageHero
    eyebrow="Diagnóstico Exprés"
    title="Auditá tu factura eléctrica o evaluá tu presupuesto solar"
    lead="Recibí un primer diagnóstico técnico e imparcial en menos de 48 horas."
  />
  <div class="bg-surface">
    <div class="container-sei grid gap-10 py-10 sm:py-14 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-start">
      <div class="rounded-card border border-line bg-white p-5 shadow-card sm:p-8">
        <DiagnosticoForm
          client:load
          turnstileSiteKey={turnstileSiteKey()}
          whatsappUrl={whatsappUrl(site.whatsapp, INVOICE_WHATSAPP_TEXT)}
        />
      </div>
      <aside aria-labelledby="que-pasa" class="flex flex-col gap-6 lg:sticky lg:top-24">
        <div>
          <h2 id="que-pasa" class="text-h3">
            Qué pasa después
          </h2>
          <ol class="mt-4 flex flex-col gap-4">
            {steps.map((s, i) => (
              <li class="flex gap-3">
                <span class="grid size-8 shrink-0 place-items-center rounded-full border-2 border-primary-600 bg-white text-sm font-bold text-primary-700">
                  {i + 1}
                </span>
                <span>
                  <span class="block font-semibold">{s.t}</span>
                  <span class="text-sm text-ink-muted">{s.d}</span>
                </span>
              </li>
            ))}
          </ol>
        </div>
        <div class="rounded-card border border-line bg-white p-5 text-sm">
          <p class="flex items-center gap-2 font-semibold">
            <Icon name="shield" class="size-5 text-primary-700" />
            Tus datos, protegidos
          </p>
          <p class="mt-2 text-ink-muted">
            Los archivos se guardan en un almacenamiento privado y solo Federico puede verlos. Conocé la{' '}
            <a href="/confidencialidad" class="text-primary-700 underline underline-offset-4">
              garantía de confidencialidad
            </a>
            .
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
