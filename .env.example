# Copiá este archivo a .env (make dev lo hace solo si no existe).
# Nunca subas .env al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=sei
# Dueño de la base: lo usa solo Alembic para las migraciones.
POSTGRES_USER=sei_owner
POSTGRES_PASSWORD=dev-owner-password
# Usuario con permisos mínimos (SELECT/INSERT/UPDATE/DELETE) que usa la API.
DB_API_USER=sei_api
DB_API_PASSWORD=dev-api-password

# --- API ---
# development | test | production (en production se ocultan /api/docs)
ENVIRONMENT=development
# Orígenes permitidos por CORS, en formato JSON. Solo el dominio propio.
CORS_ORIGINS=["http://localhost:8080","http://localhost:4321"]
# Clave para firmar sesiones y hashear IPs. En producción: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me

# --- Almacenamiento S3 (MinIO en local, Cloudflare R2 en producción) ---
S3_ACCESS_KEY=sei-minio
S3_SECRET_KEY=sei-minio-secret
# Fotos de obras (lectura pública, detrás de CDN).
S3_BUCKET_PUBLIC=sei-public
# Archivos de leads (sin acceso público, solo URLs firmadas).
S3_BUCKET_PRIVATE=sei-private

# --- Web ---
# URL pública del sitio (canonical, sitemap, Open Graph).
PUBLIC_SITE_URL=http://localhost:8080
# URL pública del bucket de fotos (MinIO en local, dominio del CDN de R2 en producción).
PUBLIC_MEDIA_URL=http://localhost:9000/sei-public
# URL de la API que usa `astro build` para leer obras, artículos y ajustes.
API_INTERNAL_URL=http://localhost:8000
# Poné 1 solo para compilar la web sin API (páginas sin datos). Nunca en producción.
SEI_OFFLINE_BUILD=0

# --- Correo ---
# smtp (Mailpit en local), memory (tests) o console. En producción: smtp.
MAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1125
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
MAIL_FROM="S.E.I. Servicio Eléctrico Integral <no-responder@servielect.com.ar>"
# Quién recibe el aviso de cada consulta nueva. TODO(federico): confirmar.
MAIL_LEADS_TO=servielect@infovia.com.ar

# --- Cloudflare Turnstile (captcha invisible) ---
# Claves de PRUEBA de Cloudflare (siempre pasan). En producción usá las reales del panel de Cloudflare.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# --- Almacenamiento (endpoint que usa la API) ---
# MinIO local sin Docker: http://localhost:9010. Con Docker Compose se fija a http://minio:9000.
S3_ENDPOINT_URL=http://localhost:9010
S3_REGION=auto

# --- Consultas ---
LEADS_PER_IP_PER_HOUR=5
# Ley 25.326: las consultas "nuevo" o "descartado" se borran pasados estos meses (make purge-leads).
LEAD_RETENTION_MONTHS=24
