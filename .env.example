# Copiá este archivo a .env (make dev lo hace solo si no existe).
# Nunca subas .env al repositorio.

# --- PostgreSQL ---
POSTGRES_DB=sei
# Dueño de la base: lo usa solo Alembic para las migraciones.
POSTGRES_USER=sei_owner
POSTGRES_PASSWORD=dev-owner-password
# Usuario con permisos mínimos (SELECT/INSERT/UPDATE/DELETE) que usa la API.
DB_API_USER=sei_api
DB_API_PASSWORD=dev-api-password

# --- API ---
# development | test | production (en production se ocultan /api/docs)
ENVIRONMENT=development
# Orígenes permitidos por CORS, en formato JSON. Solo el dominio propio.
CORS_ORIGINS=["http://localhost:8080","http://localhost:4321"]
# Clave para firmar sesiones y hashear IPs. En producción: openssl rand -hex 32
SECRET_KEY=dev-secret-change-me

# --- Almacenamiento S3 (MinIO en local, Cloudflare R2 en producción) ---
S3_ACCESS_KEY=sei-minio
S3_SECRET_KEY=sei-minio-secret
# Fotos de obras (lectura pública, detrás de CDN).
S3_BUCKET_PUBLIC=sei-public
# Archivos de leads (sin acceso público, solo URLs firmadas).
S3_BUCKET_PRIVATE=sei-private

# --- Web ---
# URL pública del sitio (canonical, sitemap, Open Graph).
PUBLIC_SITE_URL=http://localhost:8080
# URL pública del bucket de fotos (MinIO en local, dominio del CDN de R2 en producción).
PUBLIC_MEDIA_URL=http://localhost:9000/sei-public
